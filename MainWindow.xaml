<Window x:Class="WpfAppGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppGui"
        mc:Ignorable="d"
        Title="主視窗" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 區塊 1: 色度計 Comport 設定 -->
        <GroupBox Header="色度計 PCM2-100 Comport 設定" Grid.Row="0" Grid.Column="0" Margin="10" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="通訊埠：" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox x:Name="CmbColorimeterPort" Grid.Row="0" Grid.Column="1" Margin="5" />

                <Label Content="傳輸速率：" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox x:Name="CmbColorimeterBaudRate" Grid.Row="1" Grid.Column="1" Margin="5">
                    <ComboBoxItem Content="9600" />
                    <ComboBoxItem Content="19200" />
                    <ComboBoxItem Content="38400" />
                    <ComboBoxItem Content="57600" />
                    <ComboBoxItem Content="115200" />
                </ComboBox>

                <Label Content="資料位元：" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox x:Name="CmbColorimeterDataBits" Grid.Row="2" Grid.Column="1" Margin="5">
                    <ComboBoxItem Content="5" />
                    <ComboBoxItem Content="6" />
                    <ComboBoxItem Content="7" />
                    <ComboBoxItem Content="8" />
                </ComboBox>

                <Label Content="檢查位元：" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox x:Name="CmbColorimeterParity" Grid.Row="3" Grid.Column="1" Margin="5">
                    <ComboBoxItem Content="None" />
                    <ComboBoxItem Content="Even" />
                    <ComboBoxItem Content="Odd" />
                </ComboBox>

                <Label Content="停止位元：" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox x:Name="CmbColorimeterStopBits" Grid.Row="4" Grid.Column="1" Margin="5">
                    <ComboBoxItem Content="0" />
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- 區塊 2: DUT Comport 設定 -->
        <GroupBox Header="DUT Comport 設定" Grid.Row="0" Grid.Column="1" Margin="10" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="通訊埠：" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox x:Name="CmbDutPort" Grid.Row="0" Grid.Column="1" Margin="5" />

                <Label Content="傳輸速率：" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox x:Name="CmbDutBaudRate" Grid.Row="1" Grid.Column="1" Margin="5">
                    <ComboBoxItem Content="9600" />
                    <ComboBoxItem Content="19200" />
                    <ComboBoxItem Content="38400" />
                    <ComboBoxItem Content="57600" />
                    <ComboBoxItem Content="115200" />
                </ComboBox>

                <Label Content="資料位元：" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox x:Name="CmbDutDataBits" Grid.Row="2" Grid.Column="1" Margin="5">
                    <ComboBoxItem Content="5" />
                    <ComboBoxItem Content="6" />
                    <ComboBoxItem Content="7" />
                    <ComboBoxItem Content="8" />
                </ComboBox>

                <Label Content="檢查位元：" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox x:Name="CmbDutParity" Grid.Row="3" Grid.Column="1" Margin="5">
                    <ComboBoxItem Content="None" />
                    <ComboBoxItem Content="Even" />
                    <ComboBoxItem Content="Odd" />
                </ComboBox>

                <Label Content="停止位元：" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox x:Name="CmbDutStopBits" Grid.Row="4" Grid.Column="1" Margin="5">
                    <ComboBoxItem Content="0" />
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- 區塊 3: 基本功能 -->
        <GroupBox Header="基本功能" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="10" Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 設定階數 -->
                <Label Content="設定幾階：" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                <ComboBox x:Name="CmbSteps" Grid.Row="0" Grid.Column="1" Margin="5" SelectedIndex="4">
                    <ComboBoxItem Content="4" />
                    <ComboBoxItem Content="8" />
                    <ComboBoxItem Content="16" />
                    <ComboBoxItem Content="32" />
                    <ComboBoxItem Content="64" />
                </ComboBox>

                <!-- 間隔時間 -->
                <Label Content="間隔時間 (ms)：" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                <TextBox x:Name="TxtIntervalTime" Grid.Row="1" Grid.Column="1" Margin="5" />

                <!-- 顯示測試數據 -->
                <TextBlock Text="測試數據：" Grid.Row="2" Grid.Column="0" Margin="5,10,5,5" VerticalAlignment="Top" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" />

                <!-- 執行與停止按鈕 -->
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                    <Button Content="執行" Width="100" Margin="5" />
                    <Button Content="停止" Width="100" Margin="5" />
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
